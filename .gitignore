# Build trees (anchored to repo root: third_party/ has a source dir
# literally named libdecor/build, which FLTK's CMakeLists does compile)
#
# /build/ is published as built artifacts only: the app bundle and the two
# binaries are kept so they can be downloaded without compiling, while the
# CMake internals below stay out. Note /build/* (not /build/), because git
# cannot re-include a file whose parent directory is excluded.
#
# Deliberately NOT published: CMakeFiles/*.o, CMakeCache.txt (holds local
# absolute paths), ninja logs, Testing/ and the stale pre-rename
# DraftLaba2.app / DraftLaba2Scan.
/build/*
!/build/Laba2.app/
!/build/Laba2Scan
!/build/liblaba2_core.a

/build-*/
/cmake-build-*/
/out/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/compile_commands.json

# IDE metadata
.idea/
.vscode/
*.iml
/.cache/
.clangd

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Python (tests/ contains generator scripts)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Stray output artifacts
task/task1.save
tests/data/*.csv
*.save

# Local secrets and machine-local overrides (public repo)
.env
.env.*
*.pem
id_rsa*
.netrc